# Copy this file to .env (same folder) and fill in your key.
# .env is git-ignored, so the key never gets committed. Never paste the key into a chat.
# Read by: python -m console.chat and python -m console.tui

# Groq (free tier, replies in 1-2 s). Get a key at https://console.groq.com/keys
CEAI_LLM_BASE_URL=https://api.groq.com/openai/v1
CEAI_LLM_MODEL=openai/gpt-oss-120b
CEAI_LLM_API_KEY=

# Optional
# Reasoning models (gpt-oss) count their thinking toward this limit, so leave room
CEAI_CHAT_MAX_TOKENS=1000
# List the models your key can use: .venv/Scripts/python scripts/list_llm_models.py
